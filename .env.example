# Yerel geliştirme için örnek. Kopyalayıp kendi değerlerini gir:
#   cp .env.example .env
# Uygulama açılışta .env dosyasını otomatik okur. Ortamda zaten tanımlı olan
# değişkenlerin üzerine yazmaz. Kubernetes'te bu dosya kullanılmaz; değerler
# ConfigMap ve Secret'tan gelir.
#
# DB_* satırlarının HEPSİNİ silersen (veya yorum yaparsan) uygulama Postgres'siz,
# bellek-içi depoyla çalışır. Bir kısmını silersen hata verip kapanır.
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=secret
DB_NAME=tasks
